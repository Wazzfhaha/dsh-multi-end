{
  "name": "dsh-ssh-workspaces",
  "version": "0.0.6",
  "description": "DSH 多端管理：通过已有 SSH 配置管理远端 DSH 工作区与会话（开发验证版）",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT",
  "files": [
    "src/**/*.js",
    "src/**/*.css",
    "src/**/*.py",
    "README.md",
    "LICENSE",
    "docs/compatibility.md",
    "docs/install.md"
  ]
}
