{
  "name": "dsh-ssh-workspaces",
  "version": "0.0.13",
  "description": "DSH 多端管理 · Remote SSH：通过 SSH 在同一原生侧栏管理多台机器的工作区与会话。",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "ssh2-streams": "0.4.10",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT",
  "files": [
    "cordis.patch.yml",
    "src/**/*.js",
    "src/**/*.css",
    "src/**/*.py",
    "README.md",
    "LICENSE",
    "docs/compatibility.md",
    "docs/install.md",
    "screenshots.json",
    "assets/screenshots/*.png"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wazzfhaha/dsh-multi-end.git"
  },
  "homepage": "https://github.com/Wazzfhaha/dsh-multi-end#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "remote-ssh",
    "multi-host",
    "workspaces"
  ]
}
